{
  "skillListingBudgetFraction": 0.025,
  "permissions": {
    "allow": [
      "Agent",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm run test:run *)",
      "Bash(npm run test:coverage *)",
      "Bash(npm run lint:check *)",
      "Bash(npm run format:check *)",
      "Bash(npm run validate *)",
      "Bash(npm run build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Edit",
      "Glob",
      "Grep",
      "LS",
      "NotebookEdit",
      "Read",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(npm publish:*)"
    ]
  },
  "enabledPlugins": {
    "deadweight@e-xode": true
  },
  "extraKnownMarketplaces": {
    "e-xode": {
      "source": {
        "source": "github",
        "repo": "e-xode/deadweight"
      }
    }
  },
  "outputStyle": "exode-dev"
}
