# Docker Compose: local DB (node + mongo) when uncommented.
# Comment this line out to connect to a remote MongoDB via MONGO_HOST/MONGO_TYPE below.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# Optional: attach the node container to an existing Docker network (a reverse proxy, for example).
# Append :docker-compose.network.yml to COMPOSE_FILE and name the network here.
# SHARED_NETWORK=
# MONGO_PORT=27017   # host port for the local mongo container; change if 27017 is already taken
# BIND_ADDRESS=127.0.0.1   # host interface for the published dev ports (node and mongo); set 0.0.0.0 to reach a remote dev box

NODE_ENV=development
NODE_PORT=3002
# Public origin of the site. In production it MUST be the public https origin (e.g. https://www.example.com).
NODE_HOST=http://localhost:3002

# SMTP. Leave MAILER_HOST unset in development: emails are not sent and security codes are printed
# in the server console. Required in production (codes are never logged there).
# MAILER_HOST=smtp.example.com
# MAILER_PORT=587
# MAILER_SSL=false
# MAILER_LOGIN=your_email@example.com
# MAILER_PASSWORD=your_app_password
MAILER_FROM=noreply@example.com
# Recipient of the contact form (default MAILER_FROM)
# MAILER_TO=contact@example.com

# MongoDB. With the local compose file the database user is created on first start from these values.
# Without Docker, the user must exist in the MONGO_DB database (not in admin), or leave MONGO_USER empty
# for a MongoDB without authentication.
MONGO_DB=app
MONGO_HOST=localhost
MONGO_USER=user
MONGO_PWD=password
MONGO_TYPE=mongodb

# Session cookie secret. Optional in development. In production the server refuses to start unless it
# is a random value of at least 32 characters: openssl rand -hex 32
COOKIE_SECRET=

# Passwordless /api/dev/login for agents and visual QA, dev server only. It needs ALL of: NODE_ENV not
# production, DEV_LOGIN_ENABLED=true and a DEV_LOGIN_TOKEN of 32+ chars, sent as the x-dev-login-token header.
# It signs in only DEV_LOGIN_EMAIL (default qa@e-xode.net, seeded by scripts/seed-dev-user.mjs). Never set in production.
# DEV_LOGIN_ENABLED=false
# DEV_LOGIN_TOKEN=
# DEV_LOGIN_EMAIL=qa@e-xode.net

# Google Analytics
GA_MEASUREMENT_ID=

# reCAPTCHA v3. Skipped in development. REQUIRED in production: without the secret key, signup and
# the contact form are refused.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum accepted score, 0 to 1 (default 0.5)
# RECAPTCHA_MIN_SCORE=0.5

# Facebook
FACEBOOK_APP_ID=

# Social Media Links
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TELEGRAM=

# Site name used in titles and structured data (default App)
APP_NAME=

# Public base path when the app is served below the root (default /)
# BASE=/

# Logging: error, warn, info or debug (default info)
LOG_LEVEL=info

# Dev server file watching: set to true when bind mounts do not deliver inotify events
VITE_USE_POLLING=false

# Extra hosts the Vite dev server accepts (comma-separated, dev only)
VITE_ALLOWED_HOSTS=
